{
  "name": "deployment-governance",
  "description": "AI-powered deployment governance with risk analysis and approvals",
  "steps": [
    {
      "id": "get-diff",
      "type": "github",
      "config": {
        "operation": "get_diff"
      }
    },
    {
      "id": "risk-analysis",
      "type": "ai.generate",
      "depends_on": ["get-diff"],
      "config": {
        "prompt": "Rate this code diff risk 1-10. 1=safe, 10=critical.\n\n{{steps.get-diff.diff}}\n\nReturn only the number.",
        "output_format": "text"
      }
    },
    {
      "id": "generate-review",
      "type": "ai.generate",
      "depends_on": ["get-diff"],
      "config": {
        "prompt": "Review this diff. List issues with file:line format.\n\n{{steps.get-diff.diff}}",
        "output_format": "text"
      }
    },
    {
      "id": "post-inline-comments",
      "type": "github",
      "depends_on": ["generate-review"],
      "config": {
        "operation": "post_inline_comments",
        "body": "{{steps.generate-review.content}}",
        "output_format": "text",
        "dedup": true
      }
    },
    {
      "id": "post-summary",
      "type": "github",
      "depends_on": ["risk-analysis", "generate-review"],
      "config": {
        "operation": "post_comment",
        "body": "🤖 AI Review\n\nRisk: {{steps.risk-analysis.content}}/10\n\n{{steps.generate-review.content}}"
      }
    }
  ]
}